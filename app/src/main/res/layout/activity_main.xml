<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151517"
    android:layoutDirection="rtl"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layoutDirection="ltr">
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:layout_gravity="left|center_vertical"
            android:background="@drawable/bg_circle"
            android:src="@drawable/ic_settings"
            android:tint="#8BBEFF"
            android:contentDescription="تنظیمات"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="right|center_vertical"
            android:gravity="center_vertical"
            android:text="آوانگار"
            android:textColor="#F9F9FB"
            android:textSize="29sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="رونویسی زنده"
                android:textColor="#9DA6B5"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فقط فارسی"
                android:textColor="#8BBEFF"
                android:textSize="13sp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#303035"/>
        <ScrollView
            android:id="@+id/transcriptScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <TextView
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="19dp"
                android:text="گفتار فارسی اینجا نوشته می‌شود…"
                android:textColor="#8E919C"
                android:textSize="21sp"
                android:lineSpacingExtra="7dp"
                android:textDirection="rtl"
                android:gravity="top|right"
                android:clickable="true"
                android:contentDescription="متن رونویسی؛ برای کپی تمام متن لمس کنید"/>
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center"
        android:textColor="#A8B8D0"
        android:textSize="12sp"
        android:text="برای شروع، دکمه ضبط را بزنید"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="67dp"
            android:layout_height="67dp"
            android:background="@drawable/bg_circle"
            android:src="@drawable/ic_trash"
            android:contentDescription="حذف تمام متن"/>
        <LinearLayout
            android:id="@+id/recordControl"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="70dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:gravity="center_vertical"
            android:paddingLeft="18dp"
            android:paddingRight="12dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="شروع، مکث یا ادامه ضبط">
            <ImageView
                android:id="@+id/recordGlyph"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/ic_mic"
                android:tint="#8BBEFF"/>
            <TextView
                android:id="@+id/recordLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="شروع ضبط"
                android:textSize="17sp"
                android:textColor="#E8E8EB"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/timer"
                android:layout_width="51dp"
                android:layout_height="wrap_content"
                android:gravity="right|center_vertical"
                android:text="۰:۰۰"
                android:textSize="16sp"
                android:textColor="#9BA0AE"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/saveButton"
            android:layout_width="67dp"
            android:layout_height="67dp"
            android:background="@drawable/bg_circle"
            android:src="@drawable/ic_checkmark"
            android:contentDescription="اتمام ضبط و ذخیره متن و صدا"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center">
        <TextView
            android:id="@+id/transcribeTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🎙  گفتار به متن"
            android:textColor="#8BBEFF"
            android:textSize="15sp"/>
        <TextView
            android:id="@+id/historyTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="◷  تاریخچه"
            android:textColor="#A6A6AD"
            android:textSize="15sp"
            android:clickable="true"
            android:contentDescription="تاریخچه متن‌ها و فایل‌های ضبط‌شده"/>
    </LinearLayout>
</LinearLayout>
